# ============================================================
# PEC Notes 3-1 Hub — .gitignore
# ============================================================

# ── CRITICAL: Never commit secrets ──────────────────────────
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
**/.env
**/.env.*
# .env.example IS committed on purpose (safe — no real values)

# ── Node dependencies ────────────────────────────────────────
node_modules/
backend/node_modules/
frontend/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.node_repl_history
.npm
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# ── Build artifacts ──────────────────────────────────────────
dist/
dist-ssr/
frontend/dist/
backend/dist/
build/
out/
.cache/
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

# ── Temp / upload staging ────────────────────────────────────
tmp/
temp/
uploads/
backend/uploads/
*.pid
*.seed
*.pid.lock

# ── Logs & coverage ─────────────────────────────────────────
logs/
*.log
coverage/
.nyc_output/
.parcel-cache
.eslintcache
.stylelintcache

# ── OS & IDE ─────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
