# Copy this file to .env and fill in your actual values.
# NEVER commit the real .env file — it contains secrets!

# Port the Express server will run on
PORT=5000

# MongoDB connection string
# Get from: https://cloud.mongodb.com → Connect → Drivers
MONGO_URI="mongodb+srv://<db_user>:<db_password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority"

# Cloudinary credentials
# Get from: https://cloudinary.com/console → Dashboard
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# Admin login credentials (for /admin panel)
ADMIN_EMAIL="admin@yourdomain.com"
ADMIN_PASSWORD="your_secure_admin_password"

# JWT Secret — use a long random string (e.g. 64+ chars)
JWT_SECRET="your_super_long_random_jwt_secret_key_here"

# iLovePDF API keys (for PDF compression > 10MB)
# Get from: https://developer.ilovepdf.com/
ILOVEPDF_PUBLIC_KEY="project_public_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
ILOVEPDF_SECRET_KEY="secret_key_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
